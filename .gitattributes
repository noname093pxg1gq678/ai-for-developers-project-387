# Нормализация переводов строк: shell-скрипты исполняются на Linux-раннере,
# CRLF в них ломает запуск. Остальной текст - LF в репозитории.
*.sh text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.pkl text eol=lf
