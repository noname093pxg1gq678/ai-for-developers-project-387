{
  "name": "gitlab-relay",
  "version": "0.0.0",
  "private": true,
  "description": "Вебхук-релей self-hosted GitLab: события issue и note -> guard-фильтры -> запуск пайплайна агента",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vitest": "^4.0.0",
    "yaml": "^2.8.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
